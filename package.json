{
  "name": "@webdavis/omp-clearscreen",
  "version": "0.1.0",
  "description": "Clear omp's screen with Ctrl+L, keeping the scrollback, the session and its context.",
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "omp-extension",
    "clearscreen",
    "keybinding"
  ],
  "license": "MIT",
  "author": "Stephen A. Davis (https://github.com/webdavis)",
  "homepage": "https://github.com/webdavis/omp-clearscreen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdavis/omp-clearscreen.git"
  },
  "bugs": {
    "url": "https://github.com/webdavis/omp-clearscreen/issues"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "omp": {
    "extensions": [
      "./src/clearscreen.ts"
    ],
    "settings": {
      "key": {
        "type": "string",
        "default": "ctrl+l",
        "description": "The key that clears the screen, named as in omp's keybindings.yml"
      }
    }
  },
  "scripts": {
    "test": "bun test test/unit",
    "test:omp": "bun test test/omp",
    "test:all": "bun test",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "19.2.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
